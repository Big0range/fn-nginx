#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('myapp:server');
var http = require('http');
var fs = require('fs');
var path = require('path');
const config = require("../config")
console.log(config)
/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(config.PORT || '12400');
app.set('port', port);

/**
 * 统一网关：fnOS 校验会话后，把 /app/simple-nginx 的请求转发到
 * ${TRIM_APPDEST}/app.sock，与 app/ui/config 的 gatewaySocket 保持一致。
 */
var socketPath = process.env.TRIM_APPDEST ? path.join(process.env.TRIM_APPDEST, 'app.sock') : null;

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

if (socketPath) {
  // 上次进程退出可能残留 socket 文件，不清理会 EADDRINUSE
  try {
    fs.unlinkSync(socketPath);
  } catch (e) {}

  var gatewayServer = http.createServer(app);
  gatewayServer.on('error', onError);
  gatewayServer.on('listening', function () {
    // 网关与应用的运行用户可能不同，连接 Unix Socket 需要写权限
    try {
      fs.chmodSync(socketPath, 0o666);
    } catch (e) {}
    console.log('Gateway listening on ' + socketPath);
  });
  gatewayServer.listen(socketPath);
}


/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = socketPath && error.address === socketPath
    ? 'Socket ' + socketPath
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = this.address();
  var bind = typeof addr === 'string'
    ? 'socket ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
