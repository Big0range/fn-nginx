#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 与 app/server/config/index.js 保持一致：nginx 运行在 TRIM_PKGVAR/nginx 下
NGINX_BASE="${TRIM_PKGVAR}/nginx"
NGINX="${NGINX_BASE}/sbin/nginx"
NGINX_C="${NGINX_BASE}/conf/nginx.conf"

# write the command to start your program here 
CMD="/var/apps/nodejs_v24/target/bin/node ${TRIM_APPDEST}/server/bin/www"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    # run cmd to start process
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    # write pid to pidfile
    printf "%s" "$!" > ${PID_FILE}
    # log_msg "CMD = ${CMD}"
    # log_msg "pid = $!"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

nginx_pid() {
    local file pid
    for file in "${NGINX_BASE}/logs/nginx.pid" "${NGINX_BASE}/run/nginx.pid" "${NGINX_BASE}/nginx.pid"; do
        [ -r "${file}" ] || continue
        pid=$(head -n 1 "${file}" | tr -d '[:space:]')
        if [ -n "${pid}" ]; then
            printf "%s" "${pid}"
            return 0
        fi
    done
    return 1
}

cleanup_nginx_pid() {
    rm -f "${NGINX_BASE}/logs/nginx.pid" "${NGINX_BASE}/run/nginx.pid" "${NGINX_BASE}/nginx.pid"
}

# 参考 app/server/utils/nginx.js 的 stop()：
# nginx -p <prefix> -c <conf> -s quit，然后轮询等待进程退出
stop_nginx() {
    if [ ! -x "${NGINX}" ]; then
        log_msg "nginx not found: ${NGINX}, skip"
        return 0
    fi

    local pid
    if ! pid=$(nginx_pid); then
        log_msg "nginx not running, skip"
        return 0
    fi

    if ! check_process "${pid}"; then
        # 进程已不存在，清理残留 pid 文件
        cleanup_nginx_pid
        log_msg "nginx process ${pid} not exist, remove pid file"
        return 0
    fi

    log_msg "Stopping nginx (pid=${pid}) ..."
    "${NGINX}" -p "${NGINX_BASE}/" -c "${NGINX_C}" -s quit >> "${LOG_FILE}" 2>&1

    local count=0
    while check_process "${pid}" && [ ${count} -lt 5 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "waiting nginx terminal... (${count}s/5s)"
    done

    if check_process "${pid}"; then
        log_msg "send KILL signal to nginx PID:${pid}..."
        kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        sleep 1
        cleanup_nginx_pid
    else
        log_msg "nginx stopped"
    fi

    if check_process "${pid}"; then
        log_msg "nginx stop failed (pid=${pid})"
        return 1
    fi

    return 0
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_nginx
    nginx_result=$?
    stop_process
    exit ${nginx_result}
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac